# No external database required in local mode; data persists in this directory.
DATABASE_URL=pglite://./data/catalog
HOST=127.0.0.1
PORT=3000
# Optional: require this value in x-api-key on catalog endpoints.
API_KEY=
# Embedded database: use this to sync inside the API process.
# External PostgreSQL: set false and run npm run worker separately.
AUTO_SYNC=true
# Only within 15:00 <= local time < 16:00 Asia/Vientiane. API reads work all day.
SYNC_INTERVAL_MINUTES=15
# Keep supplier/cost APIs private. Do not ship this key to the customer browser.
# API_KEY above must be nonempty before server startup.
TELEGRAM_API_TOKEN_BOT=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ENABLED=false
ORDERS_ENABLED=false
# Browser cookie writes must match this origin; use HTTPS in production.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Leave empty for local-only review. Telegram menu requires a deployed HTTPS URL.
ADMIN_APP_URL=
# Base64 encoding of 32 random bytes. Keep separately from data/admin-backups.
ADMIN_BACKUP_KEY=
